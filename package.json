{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "typedoc-plugin-hash-link-references",
    "version": "1.0.3",
    "private": false,
    "description": "TypeDoc plugin that resolves VS Code-friendly path#Symbol links to source-backed TypeDoc reflections.",
    "keywords": [
        "documentation",
        "typedoc",
        "typedoc-plugin",
        "declaration-reference",
        "markdown"
    ],
    "homepage": "https://github.com/Nick2bad4u/typedoc-plugin-hash-link-references#readme",
    "bugs": {
        "url": "https://github.com/Nick2bad4u/typedoc-plugin-hash-link-references/issues",
        "email": "20943337+Nick2bad4u@users.noreply.github.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Nick2bad4u/typedoc-plugin-hash-link-references.git"
    },
    "license": "MIT",
    "author": "Nick2bad4u <20943337+Nick2bad4u@users.noreply.github.com> (https://github.com/Nick2bad4u)",
    "contributors": [
        {
            "name": "Nick2bad4u",
            "email": "20943337+Nick2bad4u@users.noreply.github.com",
            "url": "https://github.com/Nick2bad4u"
        }
    ],
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/plugin.d.ts",
            "import": "./dist/plugin.js"
        },
        "./core": {
            "types": "./dist/core.d.ts",
            "import": "./dist/core.js"
        },
        "./package.json": "./package.json"
    },
    "main": "./dist/plugin.js",
    "types": "./dist/plugin.d.ts",
    "files": [
        "dist",
        "CHANGELOG.md"
    ],
    "workspaces": [
        "docs/docusaurus"
    ],
    "scripts": {
        "build": "npm run clean:dist && tsc -p tsconfig.build.json",
        "build:runtime": "npm run build",
        "changelog:generate": "git cliff --config node_modules/gitcliff-config-nick2bad4u/cliff.toml --github-repo Nick2bad4u/typedoc-plugin-hash-link-references --output CHANGELOG.md",
        "changelog:preview": "git cliff --config node_modules/gitcliff-config-nick2bad4u/cliff.toml --github-repo Nick2bad4u/typedoc-plugin-hash-link-references --unreleased",
        "changelog:release-notes": "git cliff --config node_modules/gitcliff-config-nick2bad4u/cliff.toml --github-repo Nick2bad4u/typedoc-plugin-hash-link-references --current",
        "clean:dist": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
        "clean:docs": "node -e \"require('node:fs').rmSync('docs/docusaurus/build',{recursive:true,force:true});require('node:fs').rmSync('docs/docusaurus/.docusaurus',{recursive:true,force:true});require('node:fs').rmSync('docs/docusaurus/site-docs/developer/api',{recursive:true,force:true})\"",
        "coverage": "npm run build && vitest run --coverage",
        "docs:api": "npm run --workspace docs/docusaurus docs:api",
        "docs:build": "npm run --workspace docs/docusaurus build",
        "docs:build:local": "npm run --workspace docs/docusaurus build:local",
        "docs:serve": "npm run --workspace docs/docusaurus serve",
        "docs:start": "npm run --workspace docs/docusaurus start",
        "docs:typecheck": "npm run --workspace docs/docusaurus typecheck",
        "lint": "eslint . --cache --cache-strategy content --cache-location .cache/.eslintcache",
        "lint:attw": "attw --pack . --profile esm-only",
        "lint:css": "stylelint --cache --config stylelint.config.mjs --cache-strategy content --cache-location .cache/stylelintcache \"docs/docusaurus/src/**/*.css\"",
        "lint:css:fix": "stylelint --cache --config stylelint.config.mjs --cache-strategy content --cache-location .cache/stylelintcache \"docs/docusaurus/src/**/*.css\" --fix",
        "lint:gitleaks": "gitleaks dir --config .gitleaks.toml .",
        "lint:jscpd": "jscpd --config node_modules/jscpd-config-nick2bad4u/jscpd.json",
        "lint:lychee": "lychee --config node_modules/lychee-config-nick2bad4u/lychee.toml .",
        "lint:lychee:smoke": "lychee --config node_modules/lychee-config-nick2bad4u/lychee.toml --dump-inputs README.md",
        "lint:package": "sort-package-json --check package.json docs/docusaurus/package.json && npmPkgJsonLint . --configFile .npmpackagejsonlintrc.json --ignorePath .npmpackagejsonlintignore",
        "lint:package:fix": "sort-package-json package.json docs/docusaurus/package.json",
        "lint:package:strict": "npm run package:check && npm run lint:publint && npm run lint:attw && npm run lint:package",
        "lint:package-check": "npm run package:check && npm run lint:publint && npm run lint:attw",
        "lint:package-json": "npmPkgJsonLint . --config .npmpackagejsonlintrc.json",
        "lint:prettier": "prettier . --log-level warn --cache --cache-location=.cache/.prettier-cache --cache-strategy=content --check",
        "lint:prettier:fix": "prettier . --log-level warn --cache --cache-location=.cache/.prettier-cache --cache-strategy=content --write",
        "lint:publint": "publint",
        "lint:remark": "remark . --frail --ignore-path .remarkignore",
        "lint:remark:fix": "remark . --ignore-path .remarkignore --output",
        "lint:yamllint": "yamllint -c .yamllint .",
        "prepack": "npm run build",
        "package:check": "npm pack --dry-run",
        "prepublishOnly": "npm run release:check",
        "release:check": "npm run release:verify",
        "release:verify": "npm run sync:peer-typedoc-range:check && npm run sync:node-version-files:check && npm run lint && npm run lint:css && npm run typecheck && npm run test && npm run docs:build && npm run lint:remark && npm run lint:prettier && npm run lint:package && npm run lint:package-check && npm run lint:gitleaks",
        "sync:node-version-files": "node scripts/sync-node-version-files.mjs",
        "sync:node-version-files:check": "node scripts/sync-node-version-files.mjs --check-current",
        "sync:peer-typedoc-range": "node scripts/sync-peer-typedoc-range.mjs",
        "sync:peer-typedoc-range:check": "node scripts/sync-peer-typedoc-range.mjs --check",
        "test": "npm run build && vitest run",
        "test:ci": "vitest run --coverage --reporter=github-actions --reporter=dot --reporter=junit --outputFile=test-report.junit.xml --silent",
        "typecheck": "tsc -p tsconfig.json --noEmit && npm run docs:typecheck",
        "types:update": "npx typesync",
        "update-actions": "npx actions-up --yes --style sha",
        "update-all": "npm run update-actions && npm run update-deps",
        "update-deps": "ncu --configFileName .ncurc.workspaces.json --configFilePath node_modules/ncu-config-nick2bad4u && npm update && npm install && npm run sync:peer-typedoc-range && npm run sync:node-version-files",
        "verify": "npm run release:verify"
    },
    "dependencies": {
        "ts-extras": "^1.3.0"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@microsoft/tsdoc-config": "^0.18.1",
        "@types/node": "^26.2.0",
        "@vitest/coverage-v8": "^4.1.11",
        "eslint": "^10.8.1",
        "eslint-config-nick2bad4u": "^14.1.0",
        "git-cliff": "^2.13.1",
        "gitcliff-config-nick2bad4u": "^1.5.0",
        "gitleaks-config-nick2bad4u": "^1.0.5",
        "jscpd": "^5.0.16",
        "jscpd-config-nick2bad4u": "^1.1.1",
        "lychee-config-nick2bad4u": "^3.0.0",
        "ncu-config-nick2bad4u": "^0.2.1",
        "npm-check-updates": "^23.0.2",
        "npm-package-json-lint": "^11.0.0",
        "npm-package-json-lint-config-nick2bad4u": "^1.0.4",
        "prettier": "^3.9.6",
        "prettier-config-nick2bad4u": "^2.0.2",
        "publint": "^0.3.24",
        "remark": "^15.0.1",
        "remark-cli": "^12.0.1",
        "remark-config-nick2bad4u": "^1.1.3",
        "secretlint": "^13.0.4",
        "secretlint-config-nick2bad4u": "^1.1.2",
        "sort-package-json": "^4.0.0",
        "stylelint": "^17.14.1",
        "stylelint-config-nick2bad4u": "^2.2.1",
        "tsdoc-config-nick2bad4u": "^1.0.6",
        "typedoc": "^0.28.20",
        "typedoc-config-nick2bad4u": "^2.0.3",
        "typescript": "^6.0.3",
        "vitest": "^4.1.11",
        "yamllint-config-nick2bad4u": "^1.1.1"
    },
    "peerDependencies": {
        "typedoc": "^0.28.20"
    },
    "packageManager": "npm@12.0.2",
    "engines": {
        "node": ">=22.0.0"
    },
    "publishConfig": {
        "provenance": true,
        "registry": "https://registry.npmjs.org/"
    },
    "allowScripts": {
        "@swc/core@1.16.1": true,
        "esbuild@0.28.1": true,
        "fsevents@2.3.3": true,
        "unrs-resolver@1.12.2": true,
        "core-js": false
    },
    "readme": "README.md"
}
